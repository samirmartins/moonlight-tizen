# Packaging stage. Starts from the image that Dockerfile.buildonly produces, so
# the Emscripten SDK does not have to be downloaded again, and turns it into a
# signed .wgt.
#
#   docker build --ulimit nofile=1024:524288 -f build-tools/Dockerfile.package -t moonlight-wgt .
#
# The --ulimit is mandatory. Without it the Tizen Studio installer aborts, see
# build-tools/README.md.
FROM moonlight-wasm-check AS base

USER root
# DEBIAN_FRONTEND is an ARG in the parent image, so it does not carry over here
# and tzdata would stop on an interactive prompt.
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC
RUN apt-get update && apt-get install -y \
	expect \
	openjdk-17-jdk-headless \
	zip \
	&& rm -rf /var/lib/apt/lists/*
USER moonlight
WORKDIR /home/moonlight

RUN aria2c -x 5 -s 5 -o web-cli_Tizen_Studio_6.1_ubuntu-64.bin 'https://download.tizen.org/sdk/Installer/tizen-studio_6.1/web-cli_Tizen_Studio_6.1_ubuntu-64.bin'
RUN chmod a+x web-cli_Tizen_Studio_6.1_ubuntu-64.bin
RUN ./web-cli_Tizen_Studio_6.1_ubuntu-64.bin --accept-license /home/moonlight/tizen-studio 2>&1 | tail -30
# Fail loudly here rather than 15 steps later with a confusing "tizen: not found"
RUN ls -d /home/moonlight/tizen-studio/tools/ide/bin/tizen
ENV PATH=/home/moonlight/tizen-studio/tools/ide/bin:/home/moonlight/tizen-studio/tools:${PATH}

ARG SIGNING_CERT_SHA256=""
RUN --mount=type=secret,id=tizen_author \
	if [ -f /run/secrets/tizen_author ]; then \
		mkdir -p /home/moonlight/tizen-studio-data/keystore/author && \
		cp /run/secrets/tizen_author /home/moonlight/tizen-studio-data/keystore/author/Moonlight.p12 && \
		test -n "$SIGNING_CERT_SHA256" && \
		echo "$SIGNING_CERT_SHA256  /home/moonlight/tizen-studio-data/keystore/author/Moonlight.p12" | sha256sum -c -; \
	else \
		test -z "$SIGNING_CERT_SHA256" && \
		tizen certificate -a Moonlight -f Moonlight -p 123456; \
	fi
RUN tizen security-profiles add \
	-n Moonlight \
	-a /home/moonlight/tizen-studio-data/keystore/author/Moonlight.p12 \
	-p 123456

RUN sed -i 's|/home/moonlight/tizen-studio-data/keystore/author/Moonlight.pwd||' /home/moonlight/tizen-studio-data/profile/profiles.xml
RUN sed -i 's|/home/moonlight/tizen-studio-data/tools/certificate-generator/certificates/distributor/tizen-distributor-signer.pwd|tizenpkcs12passfordsigner|' /home/moonlight/tizen-studio-data/profile/profiles.xml

# Frontend assets that the compile-only stage did not need
COPY --chown=moonlight res/ ./moonlight-tizen/res/
COPY --chown=moonlight wasm/index.html ./moonlight-tizen/wasm/
COPY --chown=moonlight wasm/platform/ ./moonlight-tizen/wasm/platform/
COPY --chown=moonlight wasm/static/ ./moonlight-tizen/wasm/static/

RUN cmake --install build --prefix build
RUN cp moonlight-tizen/res/icon.png build/widget/

# ForceGM variant. Upstream ships two widgets built from identical code; the
# only difference is this one line of metadata, which asks the TV firmware to
# put the panel into Game Mode while the app runs. It lived in res/config.xml
# until ac6ba96 removed it for crashing on newer Tizen, and upstream has shipped
# it as a separate download ever since.
#
# It is NOT the same thing as the in-app "Game Mode" switch: that one selects
# the EMSS kUltraLow latency mode (wasm/main.cpp:371), and that is what breaks
# on Tizen 9.0. With this variant the switch is meant to stay OFF.
#
#   docker build --ulimit nofile=1024:524288 --build-arg FORCE_GAME_MODE=1 \
#     -f build-tools/Dockerfile.package -t moonlight-wgt-forcegm .
#
# Declared here so every layer above stays cached between the two variants.
ARG FORCE_GAME_MODE=0
RUN if [ "$FORCE_GAME_MODE" = "1" ]; then \
		sed -i 's|<tizen:metadata key="http://samsung.com/tv/metadata/use.voiceguide"|<tizen:metadata key="http://samsung.com/tv/metadata/use.game.mode" value="true"/>\n    <tizen:metadata key="http://samsung.com/tv/metadata/use.voiceguide"|' build/widget/config.xml && \
		grep -q 'use.game.mode' build/widget/config.xml && \
		echo "config.xml: Game Mode metadata injected (ForceGM variant)"; \
	else \
		echo "config.xml: stock, no Game Mode metadata"; \
	fi

RUN echo \
	'set timeout -1\n' \
	'spawn tizen package -t wgt -- build/widget\n' \
	'expect "Author password:"\n' \
	'send -- "123456\\r"\n' \
	'expect "Yes: (Y), No: (N) ?"\n' \
	'send -- "N\\r"\n' \
	'expect eof\n' \
| expect
# Same naming as the root Dockerfile, so both paths produce the same filename
RUN VERSION=$(grep -oP 'version="\K[0-9]+\.[0-9]+\.[0-9]+' build/widget/config.xml); \
	if [ "$FORCE_GAME_MODE" = "1" ]; then SUFFIX="-ForceGM"; else SUFFIX=""; fi; \
	mv build/widget/Moonlight.wgt "Moonlight-v${VERSION}-samirmartins${SUFFIX}.wgt" && ls -la *.wgt
